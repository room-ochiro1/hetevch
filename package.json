{
  "name": "hetevch",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:web": "turbo run dev --filter=@hetevch/web",
    "dev:mobile": "pnpm --filter @hetevch/mobile start",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "check:lines": "node scripts/check-max-lines.mjs",
    "check": "pnpm check:lines && pnpm db:check && turbo run lint typecheck",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "node scripts/db-local.mjs",
    "db:migration": "supabase migration new",
    "db:check": "node scripts/db-check.mjs",
    "db:deploy": "node scripts/db-deploy.mjs",
    "db:push": "node scripts/db-deploy.mjs",
    "db:status": "supabase migration list --remote",
    "db:types": "node scripts/db-types.mjs",
    "db:types:local": "supabase gen types typescript --local > packages/shared/src/database.types.ts"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.16",
    "supabase": "^3.1.0",
    "turbo": "^2.11.11",
    "typescript": "^5.9.3"
  }
}
