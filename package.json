{
  "name": "hetevch",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:web": "turbo run dev --filter=@hetevch/web",
    "dev:mobile": "pnpm --filter @hetevch/mobile start",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "check:lines": "node scripts/check-max-lines.mjs",
    "check": "pnpm check:lines && turbo run lint typecheck",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:migration": "supabase migration new",
    "db:types": "supabase gen types typescript --local > packages/shared/src/database.types.ts"
  },
  "devDependencies": {
    "supabase": "^3.1.0",
    "turbo": "^2.11.11",
    "typescript": "^5.9.3"
  }
}
