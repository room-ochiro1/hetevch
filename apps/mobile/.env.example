# Copy to .env and fill in. Local values come from `pnpm db:start` (or `pnpm exec supabase status`).
# On a physical phone, replace 127.0.0.1 with your computer's LAN IP (e.g. http://192.168.1.10:54321).
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Optional: support address shown as "Холбоо барих" in Profile and Help (hidden when empty).
EXPO_PUBLIC_SUPPORT_EMAIL=
